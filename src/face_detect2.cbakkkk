const int min_size[12] = {5, 8, 12, 16, 24, 0, 32, 48, 0,  64, 96, 128};
const int steps[4] = { 4, 8, 16, 32 };

__attribute__((section(".text_fd")))
void get_priorbox(float *priorbox, int prior, int priorlen, int h_i, int w_j, int c_k, int image_w, int image_h)
{
    //int min_size[12] = {10, 16, 24,    32, 48,0,    64, 96,0,  128, 192, 256};
    // int steps[4] = { 8, 16, 32, 64 };
    priorbox[2] = 2 * (float)min_size[3 * prior + c_k] / (float)(image_w);
    priorbox[3] = 2 * (float)min_size[3 * prior + c_k] / (float)(image_h);
    priorbox[0] = 2 * ((float)w_j + (float)0.5) * steps[prior] / (image_w);
    priorbox[1] = 2 * ((float)h_i + (float)0.5) * steps[prior] / (image_h);
}

__attribute__((section(".text_fd")))
float overlap(FaceRect  *face1, FaceRect  *face2)
{
    if (face1->x1 > face2->x2)
        return 0;
    if (face1->y1 > face2->y2)
        return 0;
    if (face1->x2 < face2->x1)
        return 0;
    if (face1->y2 < face2->y1)
        return 0;
    int colInt = abs(MIN(face1->x2, face2->x2) - MAX(face1->x1, face2->x1));
    int rowInt = abs(MIN(face1->y2, face2->y2) - MAX(face1->y1, face2->y1));
    float overlap_area = (float)colInt * (float)rowInt;
    int area1 = (face1->x2 - face1->x1) * (face1->y2 - face1->y1);
    int area2 = (face2->x2 - face2->x1) * (face2->y2 - face2->y1);
    return overlap_area / (float)(area1 + area2 - overlap_area);
}

__attribute__((section(".text_fd")))
int nms(FaceRect *faces, FaceRect *faces_result, int face_count, int threshold)
{
    // NOT really nms, just return max score face
    float max_score = 0;
    int index = 0;
    if (face_count == 0) return 0;
    for (int i = 0; i < face_count; i++)
    {
        if (faces[i].score > max_score)
        {
            max_score = faces[i].score;
            index = i;
        }
    }
    faces_result[0].score = faces[index].score;
    faces_result[0].x1 = faces[index].x1;
    faces_result[0].y1 = faces[index].y1;
    faces_result[0].x2 = faces[index].x2;
    faces_result[0].y2 = faces[index].y2;
//    rt_kprintf("faces[%d].score = %s, x1 = %d, y1 = %d, x2 = %d, y2 = %d\n", index, float_to_string_simple(faces[index].score), faces[index].x1, faces[index].y1, faces[index].x2, faces[index].y2);
    return 1;
    // 这要重写
    // return MIN(face_count,10);
}

FaceRect faces[50];

// 手动实现的 sqrtf 函数（使用 float 类型）

__attribute__((section(".text_fd")))
float my_sqrtf(float x)
{
    if (x < 0.0f)
    {
        return -1.0f;  // 返回负值表示输入无效（负数没有实数平方根）
    }
    if (x == 0.0f || x == 1.0f)
    {
        return x;     // 0 和 1 的平方根是其自身
    }
    float guess = x / 2.0f;  // 初始猜测值为 x 的一半
    float epsilon = 0.00001f; // 允许误差
    // 使用牛顿迭代法逼近平方根
    while ((guess * guess - x) > epsilon || (guess * guess - x) < -epsilon)
    {
        guess = (guess + x / guess) / 2.0f;
    }
    return guess;
}

__attribute__((section(".text_fd")))
int objectdetect_cnn(const unsigned char *rgb_image_data, int width, int height, FaceRect *faces_temp)
{
    float output_ratio[4] = { 0.07837648607330827, 0.12955268866076342, 0.05551086974787678, 0.06884041621495385 };
    float image_w = width;
    float image_h = height;
    float variance[2] = { 0.1, 0.2 };
    int priorlen[4] = {3, 2, 2, 3};
    struct FloatTensor result[4] =
    {
        {15, 20, 51, NULL, 1},
        {7, 10, 34, NULL, 1 },
        {3, 5, 34, NULL, 1 },
        {1, 2, 51, NULL, 1 },
    };
    result[0].data_location = buffer5;
    result[1].data_location = buffer5 + 15 * 20 * 51;
    result[2].data_location = buffer5 + 15 * 20 * 51 + 7 * 10 * 34;
    result[3].data_location = buffer5 + 15 * 20 * 51 + 7 * 10 * 34 + 3 * 5 * 34;
    float confidence = 0.5;
    fd_run(result, rgb_image_data);
    int face_count = 0;
    for (int j = 0; j < 3; j++)
    {
        int length = result[j].width * result[j].height * result[j].channel;
        for (int i = 0; i < length; i++)
        {
            result[j].data_location[i] = result[j].data_location[i] * output_ratio[j];
        }
        my_softmax(&result[j]);
        for (int i = 0; i < length / 17; i++)
        {
            if (result[j].data_location[i * 17 + 16] > 1) result[j].data_location[i * 17 + 16] = 1;
            result[j].data_location[i * 17 + 15] = my_sqrtf(result[j].data_location[i * 17 + 16] * result[j].data_location[i * 17 + 15]);
        }
    }
    for (int j = 3; j >= 0 ; j--)
    {
        int w = result[j].width;
        int c = result[j].channel / 17;
        int h = result[j].height;
        int len1 = h * w * c;
        //rt_kprintf("len1 = %d\n",len1);
        for (int i = 0; i < len1; i++)
        {
            if (result[j].data_location[i * 17 + 15] < confidence)
                continue;
//            rt_kprintf("result[%d].data_location[%d] = %f\n", j, i, result[j].data_location[i * 17 + 15]);
            float priorbox[4] = { 0 };
            get_priorbox(priorbox, j, priorlen[j], i / (w * c), (i % (w * c)) / c, i % c, image_w, image_h);
//            char buffer[4][32];
//            float_to_string(priorbox[0], buffer[0], 32, 6);
//          float_to_string(priorbox[1], buffer[1], 32, 6);
//          float_to_string(priorbox[2], buffer[2], 32, 6);
//          float_to_string(priorbox[3], buffer[3], 32, 6);
//            rt_kprintf("prior box = %s,%s,%s,%s\n",buffer[0],buffer[1],buffer[2],buffer[3]);
            result[j].data_location[i * 17 + 0] = (priorbox[0] + result[j].data_location[i * 17 + 0] * variance[0] * priorbox[2]) * image_w;
            result[j].data_location[i * 17 + 1] = (priorbox[1] + result[j].data_location[i * 17 + 1] * variance[0] * priorbox[3]) * image_h;
            result[j].data_location[i * 17 + 2] = (priorbox[2] * my_expf(result[j].data_location[i * 17 + 2] * variance[1])) * image_w;
            result[j].data_location[i * 17 + 3] = (priorbox[3] * my_expf(result[j].data_location[i * 17 + 3] * variance[1])) * image_h;
//            float_to_string(result[j].data_location[i * 17 + 0], buffer[0], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 1], buffer[1], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 2], buffer[2], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 3], buffer[3], 32, 6);
//            rt_kprintf("result[%d].data_location[%d] = %s,%s,%s,%s\n",j, i, buffer[0],buffer[1],buffer[2],buffer[3]);
            for (int k = 4; k < 14; k = k + 2)
            {
                result[j].data_location[i * 17 + k] = (priorbox[0] + result[j].data_location[i * 17 + k] * variance[0] * priorbox[2]) * image_w;
                result[j].data_location[i * 17 + k + 1] = (priorbox[1] + result[j].data_location[i * 17 + k + 1] * variance[0] * priorbox[3]) * image_h;
            }
//            float_to_string(result[j].data_location[i * 17 + 0], buffer[0], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 1], buffer[1], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 2], buffer[2], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 3], buffer[3], 32, 6);
//          rt_kprintf("result[%d].data_location[%d] = %s,%s,%s,%s\n",j, i, buffer[0],buffer[1],buffer[2],buffer[3]);
            result[j].data_location[i * 17 + 0] = result[j].data_location[i * 17 + 0] - result[j].data_location[i * 17 + 2] / 2;
            result[j].data_location[i * 17 + 1] = result[j].data_location[i * 17 + 1] - result[j].data_location[i * 17 + 3] / 2;
            result[j].data_location[i * 17 + 2] = result[j].data_location[i * 17 + 2] + result[j].data_location[i * 17 + 0];
            result[j].data_location[i * 17 + 3] = result[j].data_location[i * 17 + 3] + result[j].data_location[i * 17 + 1];
//            float_to_string(result[j].data_location[i * 17 + 0], buffer[0], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 1], buffer[1], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 2], buffer[2], 32, 6);
//          float_to_string(result[j].data_location[i * 17 + 3], buffer[3], 32, 6);
//          rt_kprintf("result[%d].data_location[%d] = %s,%s,%s,%s\n",j, i, buffer[0],buffer[1],buffer[2],buffer[3]);
            if (face_count < 100)
            {
                faces[face_count].score = 100 * result[j].data_location[i * 17 + 15];
//                rt_kprintf("faces[%d].score = %s\n", face_count, float_to_string_simple(faces[face_count].score));
                faces[face_count].x1 = (int)result[j].data_location[i * 17 + 0];
                faces[face_count].y1 = (int)result[j].data_location[i * 17 + 1];
                faces[face_count].x2 = (int)result[j].data_location[i * 17 + 2];
                faces[face_count].y2 = (int)result[j].data_location[i * 17 + 3];
//                float_to_string(result[j].data_location[i * 17 + 0], buffer[0], 32, 6);
//              float_to_string(result[j].data_location[i * 17 + 1], buffer[1], 32, 6);
//              float_to_string(result[j].data_location[i * 17 + 2], buffer[2], 32, 6);
//              float_to_string(result[j].data_location[i * 17 + 3], buffer[3], 32, 6);
//              rt_kprintf("result[%d].data_location[%d] = %s,%s,%s,%s\n", j, i, buffer[0],buffer[1],buffer[2],buffer[3]);
                for (int ss = 0; ss < 10; ss++)
                {
                    faces[face_count].lm[ss] = result[j].data_location[i * 17 + 4 + ss];
                }
                face_count++;
            }
            //rt_kprintf("face box = %d,%d,%d,%d,%f\n", faces[face_count-1].x1, faces[face_count-1].y1, faces[face_count-1].x2, faces[face_count-1].y2, faces[face_count-1].score);
        }
    }
    int face = nms(faces, faces_temp, face_count, 100);
//    rt_kprintf("face = %d\n", face);
    return face;
}


__attribute__((section(".text_fd")))
void conv(struct Uint8Tensor *input, struct Uint8Tensor *output, struct Structure *conv_params, struct ConvParameter *weight)
{
//    uint32_t start_time = TIMER0_START();
    int position_h = 0;
    int position_w = 0;
    int kernel_h = conv_params->kernel_h;
    int kernel_w = conv_params->kernel_w;
    int bias_flag = conv_params->bias_flag;
    int offset_per_channel_flag = conv_params->offset_per_channel;
    int bias_offset = conv_params->bias_offset;
    int bias_offset_per_channel_flag = conv_params->bias_offset_per_channel;
    //memset(buffer_conv_u8, 0, 36864);
    // memset(buffer_conv_64, 0, 64 * 4);
    for (size_t i = 0; i < (sizeof(buffer_conv_64) / sizeof(buffer_conv_64[0])); i++)
    {
        /* code */
        buffer_conv_64[i] = 0;
    }
    
    u8 *tmp_kernel = buffer_conv_u8;
    int *position_result = buffer_conv_64;
    int step1 = kernel_h * kernel_w * input->channel;
    int step2 = kernel_w * input->channel;
    int step3 = input->width * input->channel;
    for (int i = 0; i < output->height; i++)
    {
        for (int j = 0; j < output->width; j++)
        {
            if (!(conv_params->depth_wise_flag))
            {
                memset(tmp_kernel, 0, output->channel * kernel_h * kernel_w * input->channel);
                //rt_kprintf("%d\n", output->channel * kernel_h * kernel_w * input->channel);
                for (int s = 0; s < kernel_h; s++)
                {
                    for (int t = 0; t < kernel_w; t++)
                    {
                        position_h = i * conv_params->stride_h + s - conv_params->pad_h;
                        position_w = j * conv_params->stride_w + t - conv_params->pad_w;
                        if (position_h < 0 || position_w < 0 || position_h >= input->height || position_w >= input->width)
                        {
                            continue;
                        }
                        else
                        {
                            int data_index = position_h * (step3) + position_w * input->channel;
                            for (int m = 0; m < output->channel; m++)
                            {
                                memcpy(tmp_kernel + m * (step1) + s * (step2) + t * input->channel, input->data_location + data_index, (input->channel));
                            }
                        }
                    }
                }
                for (int s = 0; s < output->channel; s++)
                {
                    int temp = 0;
                    for (int t = 0; t < step1; t++)
                    {
                        int index = s * step1 + t;
                        if (input->type == 1)
                            temp += ((int16_t)tmp_kernel[index]) * weight->weight[index];
                        else
                            temp += ((uint16_t)tmp_kernel[index]) * weight->weight[index];
                    }
                    position_result[s] = temp;
                }
            }
            else
            {
                memset(tmp_kernel, 0, output->channel * kernel_h * kernel_w);
                //rt_kprintf("%d\n", output->channel * kernel_h * kernel_w);
                int aa_h = i * conv_params->stride_h  - conv_params->pad_h;
                int aa_w = j * conv_params->stride_w  - conv_params->pad_w;
                for (int s = 0; s < kernel_h; s++)
                {
                    position_h = aa_h + s;
                    if (position_h >= input->height || position_h < 0)
                        continue;
                    for (int t = 0; t < kernel_w; t++)
                    {
                        position_w = aa_w + t;
                        if (position_w < 0 ||  position_w >= input->width)
                            continue;
                        else
                        {
                            int data_index1 = position_h * (step3) + position_w * input->channel;
                            int data_index2 = s * (step2) + t * (input->channel);
                            memcpy(tmp_kernel + data_index2, input->data_location + data_index1, input->channel);
                        }
                    }
                }
                for (int s = 0; s < output->channel; s++)
                {
                    int temp = 0;
                    for (int t = 0; t < kernel_h * kernel_w; t++)
                    {
                        int index = t * (output->channel) + s;
                        if (input->type == 1)
                            temp += (int16_t)((int8_t)tmp_kernel[index]) * weight->weight[index];
                        else
                            temp += ((uint8_t)tmp_kernel[index]) * weight->weight[index];
                    }
                    position_result[s] = temp;
                }
            }
            //add bias and offset
            if (bias_flag)
            {
                if (bias_offset_per_channel_flag)
                {
                    for (int s = 0; s < output->channel; s++)
                    {
                        position_result[s] = position_result[s] + (weight->bias[s] << weight->bias_offset_per_channel[s]);
                    }
                }
                else
                {
                    for (int s = 0; s < output->channel; s++)
                    {
                        position_result[s] = position_result[s] + (weight->bias[s] << bias_offset);
                    }
                }
            }
            //relu
            if (conv_params->nonlinear == 1)
            {
                for (int s = 0; s < output->channel; s++)
                {
                    position_result[s] = (position_result[s] > 0) ? position_result[s] : 0;
                }
            }
            if (offset_per_channel_flag)
            {
                for (int s = 0; s < output->channel; s++)
                {
                    int shift = weight->offset_per_channel[s];
                    position_result[s] = ((position_result[s] + (1 << (shift - 1))) >> shift);
                }
            }
            else
            {
                for (int s = 0; s < output->channel; s++)
                {
                    int shift = conv_params->offset;
                    position_result[s] = ((position_result[s] + (1 << (shift - 1))) >> shift);
                }
            }
            //??????channel???????
            int max = 255, min = 0;
            if (output->type == 1)
            {
                max = 127;
                min = -128;
            }
            for (int s = 0; s < output->channel; s++)
            {
                if (position_result[s] > max)
                {
                    output->data_location[i * (output->width * output->channel) + j * (output->channel) + s] = max;
                }
                else if (position_result[s] < min)
                {
                    output->data_location[i * (output->width * output->channel) + j * (output->channel) + s] = min;
                }
                else
                {
                    if (output->type == 1)
                        output->data_location[i * (output->width * output->channel) + j * (output->channel) + s] = (uint8_t)(int8_t)position_result[s];
                    else
                        output->data_location[i * (output->width * output->channel) + j * (output->channel) + s] = (uint8_t)position_result[s];
                }
            }
        }
    }
//    int ops = output->width * output->height * input->channel * output->channel;
//    if (conv_params->depth_wise_flag)
//        ops = output->width * output->height * input->channel * kernel_h * kernel_w;
//    uint32_t end_time = TIMER0_END();
//    rt_kprintf("conv    \n");
}






__attribute__((section(".text_fd")))
void conv_dp(struct Uint8Tensor *input, struct Uint8Tensor *output, struct Structure *conv_params, struct ConvParameter *weight)
{
//  uint32_t start_time = TIMER0_START();
    int i_c = input->channel;
    int o_c = output->channel;
    int input_step0 = input->width * input->channel;
    assert(i_c == o_c);
    assert(i_c == 16 || i_c == 64);
    assert(conv_params->kernel_h == 3);
    assert(conv_params->kernel_w == 3);
    for (int v = 0; v < o_c / 16; v++)
    {
        short temp_weight[16] = {0};
        int temp_result[16] = {0};
//        char tmp_kernel[16] = {0};
        int bias_local[16] = {0};
        short4xN_t weight_vec[9];
        for (int j = 0; j < 9; j++)
        {
            for (int i = 0; i < 16; i++)
            {
                temp_weight[i] = (short)weight->weight[j * i_c + i + 16 * v];
            }
            weight_vec[j] = *(short4xN_t *)temp_weight;
        }
        int bias_offset = conv_params->bias_offset;
        int bias_offset_per_channel_flag = conv_params->bias_offset_per_channel;
        for (int s = 0; s < 16; s++)
        {
            if (bias_offset_per_channel_flag)
            {
                bias_local[s] = (weight->bias[v * 16 + s] << weight->bias_offset_per_channel[v * 16 + s]) + (1 << (weight->offset_per_channel[v * 16 + s] - 1));
            }
            else
            {
                bias_local[s] = (weight->bias[v * 16 + s] << bias_offset) + (1 << (weight->offset_per_channel[v * 16 + s] - 1));
            }
        }
        int4xN_t bias_vec = *(int4xN_t *)bias_local;
        unsigned int temp_shift_lo[8] = {0};
        unsigned int temp_shift_hi[8] = {0};
        for (int i = 0; i < 8; i++)
        {
            temp_shift_lo[i] = (unsigned int)weight->offset_per_channel[v * 16 + i];
        }
        for (int i = 0; i < 8; i++)
        {
            temp_shift_hi[i] = (unsigned int)weight->offset_per_channel[v * 16 + i + 8];
        }
        uint2xN_t shift_vec_lo = *(uint2xN_t *)temp_shift_lo;
        uint2xN_t shift_vec_hi = *(uint2xN_t *)temp_shift_hi;
        for (int i = 0; i < output->height; i++)
        {
            for (int j = 0; j < output->width; j++)
            {
                // memset(temp_result, 0, 16 * 4);
                for (size_t i = 0; i < 16; i++)
                {
                    /* code */
                    temp_result[i] = 0;
                }
                
                int4xN_t temp_result1 = *(int4xN_t *)temp_result;
                for (int s = 0; s < 3; s++)
                {
                    int ss = i - 1 + s;
                    if (ss < 0 || ss >= output->height)
                        continue;
                    int step_temp = ss * (input_step0) + v * 16;
                    for (int t = 0; t < 3; t++)
                    {
                        int tt = j - 1 + t;
                        if (tt < 0 || tt >= output->width)
                            continue;
                        int index = s * 3 + t;
                        //memcpy(tmp_kernel, input->data_location + step_temp + tt *  i_c ,  16);
                        temp_result1 = _vmac(*(char4xN_t *)(input->data_location + step_temp + tt *  i_c), (weight_vec[index]), temp_result1);
                    }
                }
                temp_result1 += (bias_vec);
                int2xN_t vec_lo = _vunpack_lo(temp_result1);
                int2xN_t vec_hi = _vunpack_hi(temp_result1);
                int4xN_t temp_result5 = _vpack(_vshiftr(vec_lo, shift_vec_lo), _vshiftr(vec_hi, shift_vec_hi));
                uchar4xN_t temp1 = _vcastuc4n(_sat, _vcasts4n(_sat, temp_result5));
                int position000 = i * (output->width * output->channel) + j * (o_c) + v * 16;
                memcpy(output->data_location + position000, &temp1, 16);
            }
        }
    }
//  uint32_t end_time = TIMER0_END();
//  rt_kprintf("dp_conv \n");
}

__attribute__((section(".text_fd")))
void conv_rgb(struct Uint8Tensor *input, struct Uint8Tensor *output, struct Structure *conv_params, struct ConvParameter *weight)
{
//  unsigned int start_time = TIMER0_START();
    assert(output->channel == 16);
    char temp_weight[16] = {0};
    char4xN_t weight_vec[28];
    for (int j = 0; j < 28; j++)
    {
        for (int i = 0; i < 16; i++)
        {
            temp_weight[i] = weight->weight[i * 27 + j];
            if (j == 27) temp_weight[i] = 0;
        }
        weight_vec[j] = *(char4xN_t *)temp_weight;
    }
    //====================
    //Timer0_init();
    //unsigned int start = TIMER0_CC;
    //rt_kprintf("start = %d\n",start);
//
//
//    rt_kprintf("%d\n",dd2);
//
//    unsigned int dd = 0x1 << 16;
//    _out(_cpm, dd, 0x2000);
//    uint32_t dd2 = _in(_cpm, 0x2008);
//    rt_kprintf("%d\n",dd2);
    ////////////////////======================
    int bias_offset = conv_params->bias_offset;
    int bias_offset_per_channel_flag = conv_params->bias_offset_per_channel;
    int bias_local[16] = {0};
    for (int s = 0; s < output->channel; s++)
    {
        if (bias_offset_per_channel_flag)
        {
            bias_local[s] = (weight->bias[s] << weight->bias_offset_per_channel[s]) + (1 << (weight->offset_per_channel[s] - 1));
        }
        else
        {
            bias_local[s] = (weight->bias[s] << bias_offset) + (1 << (weight->offset_per_channel[s] - 1));
        }
    }
    int4xN_t bias_vec = *(int4xN_t *)bias_local;
    unsigned int temp_shift_lo[8] = {0};
    for (int i = 0; i < 8; i++)
    {
        temp_shift_lo[i] = (unsigned int)weight->offset_per_channel[i];
    }
    unsigned int temp_shift_hi[8] = {0};
    for (int i = 8; i < 16; i++)
    {
        temp_shift_hi[i - 8] = (unsigned int)weight->offset_per_channel[i];
    }
    uint2xN_t shift_vec_lo = *(uint2xN_t *)temp_shift_lo;
    uint2xN_t shift_vec_hi = *(uint2xN_t *)temp_shift_hi;
    unsigned char tmp_kernel[28] = {0};
    int input_step0 = input->width * input->channel;
    int temp_result[16] = {0};
    for (int i = 0; i < output->height; i++)
    {
        for (int j = 0; j < output->width; j++)
        {
            memset(tmp_kernel, 0, 28);
            if (i == 0 && j == 0)
            {
                for (int s = 1; s < 3; s++)
                {
                    for (int t = 1; t < 3; t++)
                    {
                        int position_h = s - conv_params->pad_h;
                        int position_w = t - conv_params->pad_w;
                        int data_index = position_h * (input_step0) + position_w * input->channel;
                        memcpy(tmp_kernel + s * 9 + t * 3, input->data_location + data_index, 3);
                    }
                }
            }
            else if (i == 0 && j != 0)
            {
                int position_h1 = 1 - conv_params->pad_h;
                int position_h2 = 2 - conv_params->pad_h;
                int position_w = j * conv_params->stride_w - conv_params->pad_w;
                int data_index1 = position_h1 * (input_step0) + position_w * input->channel;
                int data_index2 = position_h2 * (input_step0) + position_w * input->channel;
                memcpy(tmp_kernel + 9, input->data_location + data_index1, 9);
                memcpy(tmp_kernel + 18, input->data_location + data_index2, 9);
            }
            else if (i != 0 && j == 0)
            {
                int position_h1 = i * conv_params->stride_h + 0 - conv_params->pad_h;
                int position_h2 = i * conv_params->stride_h + 1 - conv_params->pad_h;
                int position_h3 = i * conv_params->stride_h + 2 - conv_params->pad_h;
                int position_w = 1 - conv_params->pad_w;
                int data_index = position_h1 * (input_step0) + position_w * input->channel;
                memcpy(tmp_kernel + 3, input->data_location + data_index, 6);
                data_index = position_h2 * (input_step0) + position_w * input->channel;
                memcpy(tmp_kernel + 12, input->data_location + data_index, 6);
                data_index = position_h3 * (input_step0) + position_w * input->channel;
                memcpy(tmp_kernel + 21, input->data_location + data_index, 6);
            }
            else
            {
                int position_h1 = i * conv_params->stride_h + 0 - conv_params->pad_h;
                int position_h2 = i * conv_params->stride_h + 1 - conv_params->pad_h;
                int position_h3 = i * conv_params->stride_h + 2 - conv_params->pad_h;
                int position_w = j * conv_params->stride_w + 0 - conv_params->pad_w;
                int data_index = position_h1 * (input_step0) + position_w * input->channel;
                memcpy(tmp_kernel + 0, input->data_location + data_index, 9);
                data_index = position_h2 * (input_step0) + position_w * input->channel;
                memcpy(tmp_kernel + 9, input->data_location + data_index, 9);
                data_index = position_h3 * (input_step0) + position_w * input->channel;
                memcpy(tmp_kernel + 18, input->data_location + data_index, 9);
            }
            // memset(temp_result, 0, 16 * 4);
            for (size_t i = 0; i < 16; i++)
            {
                /* code */
                temp_result[i] = 0;
            }
            
            int4xN_t temp_result1 = *(int4xN_t *)temp_result;
            for (int k = 0; k < 7; k++)
            {
                ushort2 inE = _pack(tmp_kernel[k * 4 + 0], tmp_kernel[k * 4 + 1]);
                ushort2 inF = _pack(tmp_kernel[k * 4 + 2], tmp_kernel[k * 4 + 3]);
                temp_result1 = _vmac5(weight_vec[k * 4 + 0], weight_vec[k * 4 + 1], weight_vec[k * 4 + 2], weight_vec[k * 4 + 3], inE, inF, temp_result1);
            }
            temp_result1 += (bias_vec);
            int2xN_t vec_lo = _vunpack_lo(temp_result1);
            int2xN_t vec_hi = _vunpack_hi(temp_result1);
            int2xN_t temp_result3 = _vshiftr(vec_lo, shift_vec_lo);
            int2xN_t temp_result4 = _vshiftr(vec_hi, shift_vec_hi);
            int4xN_t temp_result5 = _vpack(temp_result3, temp_result4);
            short4xN_t temp0 = _vcasts4n(_sat, temp_result5);
            uchar4xN_t temp1 = _vcastuc4n(_sat, temp0);
            int position000 = i * (output->width * output->channel) + j * (output->channel);
            memcpy(output->data_location + position000, &temp1, 16);
//            if(i==0 && j== 0){
//              for(int kk=0;kk<16;kk++){
//                  rt_kprintf("%d,",(unsigned char)temp1[kk]);
//              }
//              rt_kprintf("\n");
//
//            }
//
//            if(i==0 && j== 1){
//              for(int kk=0;kk<16;kk++){
//                  rt_kprintf("%d,",(unsigned char)temp1[kk]);
//              }
//              rt_kprintf("\n");
//
//          }
//            if(i==11 && j== 13){
//              for(int kk=0;kk<16;kk++){
//                  rt_kprintf("%d,",(unsigned char)temp1[kk]);
//              }
//              rt_kprintf("\n");
//
//          }
//            if(i == 0 && j== 0){
//
//              for(int kk=0;kk<28;kk++){
//                  rt_kprintf("%d,%d\n",(char)weight_vec[kk][0],(unsigned char)tmp_kernel[kk]);
//              }
//              rt_kprintf("\n");
//
//
//
//              for(int kk=0;kk<16;kk++){
//                  rt_kprintf("%d,",(int)temp_result1[kk]);
//              }
//              rt_kprintf("\n");
//
//            }
        }
    }
//    uint32_t end_time = TIMER0_END();
//    rt_kprintf("rgb_conv\n");
//    unsigned int star1t = TIMER0_CC;
//    rt_kprintf("start = %d\n",star1t);
}
volatile uint8_t allocated_timers = 0;
volatile uint32_t eoc_cntrs[4] = { 0 };
void end_of_count_event_hook() PRAGMA_CSECT("external_timer_interrupt") __attribute__((interrupt));

void end_of_count_event_hook()
{
    T_TimerIrq timer_irq = {{0}};
    TIMER_rd_irq(&timer_irq);
    if (timer_irq.fields.timer0_irq)
        eoc_cntrs[0]++;
    if (timer_irq.fields.timer1_irq)
        eoc_cntrs[1]++;
    if (timer_irq.fields.timer2_irq)
        eoc_cntrs[2]++;
    if (timer_irq.fields.timer3_irq)
        eoc_cntrs[3]++;
    TIMER_clr_irq(&timer_irq);
}

void timer_test()
{
	volatile uint32_t allocated_ivi = 0;
	T_Internal_Interrupt_Configuration interrupt_config = { 0 };
	allocated_ivi = ICU_IVA_Allocate((uint32_t) end_of_count_event_hook);
	interrupt_config.priority = 6;
	interrupt_config.ivi = allocated_ivi;
	ICU_Configure_TIMER_Internal_Int(&interrupt_config);
	TEST_ASSERT_EQUAL(CSL_SUCCESS, ICU_Enable());
	__asm__ volatile("eint\n"
					 "nop");
    T_TimerConfiguation t_conf = { 0 };
    uint8_t             t;
    // Configure TIMER(t)_CFG
    t_conf.cm                  = EVENT_COUNT;
    t_conf.tm                  = CNTR_CLK_CYCLES_2;
    t_conf.es                  = INTERNAL_EVENT;
    t_conf.bpen                = STOP_IN_DEBUG;
    t_conf.ru                  = TIMER_RU_COUNT_UNLATCH;
    t                          = TIMER_allocate(&t_conf);
    // Allocate Timer
    TEST_ASSERT_NOT_EQUAL(0xff, t);
    allocated_timers |= (1 << t);
    // Configure Timer
    TEST_ASSERT_EQUAL(CSL_SUCCESS, TIMER_reset(t, 2000));
    // Start test
    TEST_ASSERT_EQUAL(CSL_SUCCESS, TIMER_resume(t));
    rt_kprintf("Timers TEST: Event Count TIMER %d current counter is at 0x%x\n", t,
           TIMER_read32(t));
    while (eoc_cntrs[t] == 0)
    {
        TIMER_progress_counter(t);
    }
    // End test and report result
    rt_kprintf("Timers TEST: TIMER %d has reached %d EOCs.\n", t, eoc_cntrs[t]);
    TEST_ASSERT_EQUAL(CSL_SUCCESS, TIMER_pause(t));
    ICU_IVA_Deallocate(allocated_ivi);
	TEST_ASSERT_EQUAL(CSL_SUCCESS, ICU_Disable());
	__asm__ volatile("dint\n"
					 "nop");
}

__attribute__((section(".text_fd")))
void conv1x1xn(struct Uint8Tensor *input, struct Uint8Tensor *output, struct Structure *conv_params, struct ConvParameter *weight)
{
//  uint32_t start_time = TIMER0_START();
    int bias_offset = conv_params->bias_offset;
    int bias_offset_per_channel_flag = conv_params->bias_offset_per_channel;
    int8_t *weight_ptr1 = (int8_t *)weight->weight;
    assert(input->channel == 16 || input->channel == 64);
    assert(output->channel == 16 || output->channel == 64 || output->channel == 51 || output->channel == 34);
    int o_c = output->channel;
    int i_c = input->channel;
//    rt_kprintf("1x1_conv-start\n");
    for (int vec_part = 0; vec_part < (o_c + 15) / 16; vec_part ++)
    {
//      rt_kprintf("1x1_conv part1 %d\n",vec_part);
        int calcu_oc = 16;
        if (output->channel == 51 && vec_part == 3) calcu_oc = 3;
        if (output->channel == 34 && vec_part == 2) calcu_oc = 2;
        short temp_weight0[16] = {0};
        short4xN_t weight_out[i_c];
        for (int i = 0; i < i_c; i++)
        {
            for (int j = 0; j < calcu_oc; j++)
            {
                temp_weight0[j] = weight_ptr1[(16 * vec_part + j) * (i_c) + i];
            }
            weight_out[i] = *(short4xN_t *)temp_weight0;
        }
//      rt_kprintf("1x1_conv part2 %d\n",vec_part);
        int bias_local[16] = {0};
        for (int s = 0; s < calcu_oc; s++)
        {
            if (bias_offset_per_channel_flag)
            {
                bias_local[s] = (weight->bias[vec_part * 16 + s] << weight->bias_offset_per_channel[vec_part * 16 + s]) + (1 << (weight->offset_per_channel[vec_part * 16 + s] - 1));
            }
            else
            {
                bias_local[s] = (weight->bias[vec_part * 16 + s] << bias_offset) + (1 << (weight->offset_per_channel[vec_part * 16 + s] - 1));
            }
        }
//      rt_kprintf("1x1_conv part3 %d\n",vec_part);
        int4xN_t bias_vec = *(int4xN_t *)bias_local;
        unsigned int temp_shift_lo[8] = {0};
        unsigned int temp_shift_hi[8] = {0};
        for (int i = 0; i < 8; i++)
        {
            temp_shift_lo[i] = (unsigned int)weight->offset_per_channel[vec_part * 16 + i];
        }
        for (int i = 0; i < 8; i++)
        {
            temp_shift_hi[i] = (unsigned int)weight->offset_per_channel[vec_part * 16 + i + 8];
        }
        uint2xN_t shift_vec_lo = *(uint2xN_t *)temp_shift_lo;
        uint2xN_t shift_vec_hi = *(uint2xN_t *)temp_shift_hi;
//      rt_kprintf("1x1_conv part4 %d\n",vec_part);
        unsigned char tmp_kernel[64] = {0};
        unsigned int tmp_input1 = 0;
        unsigned int tmp_input2 = 0;
        unsigned int tmp_input3 = 0;
        unsigned int tmp_input4 = 0;
        int count0 = 0;
//      rt_kprintf("1x1_conv part %d\n",vec_part);
        for (int i = 0; i < output->height; i++)
        {
//          rt_kprintf("1x1_conv i = %d\n",i);
            for (int j = 0; j < output->width; j++)
            {
                //rt_kprintf("1x1_conv000-%d\n",j);
                memcpy(tmp_kernel, input->data_location + count0,  i_c);
                count0 += i_c;
                int4xN_t temp_result1 = {0};
                int4xN_t temp_result2 = {0};
                int4xN_t temp_result3 = {0};
                int4xN_t temp_result4 = {0};
                for (int ii = 0; ii < i_c; ii += 16)
                {
                    // memcpy(&tmp_input1, tmp_kernel + ii, 4);
                    tmp_input1 = *(int *)(tmp_kernel + ii);
                    // memcpy(&tmp_input2, tmp_kernel + ii + 4, 4);
                    tmp_input2 = *(int *)(tmp_kernel + ii + 4);
                    // memcpy(&tmp_input3, tmp_kernel + ii + 8, 4);
                    tmp_input3 = *(int *)(tmp_kernel + ii + 8);
                    // memcpy(&tmp_input4, tmp_kernel + ii + 12, 4);
                    tmp_input4 = *(int *)(tmp_kernel + ii + 12);
                    temp_result1 = _vmac5((weight_out[ii + 0]), (weight_out[ii + 1]), (weight_out[ii + 2]), (weight_out[ii + 3]), tmp_input1, temp_result1);
                    temp_result2 = _vmac5((weight_out[ii + 4]), (weight_out[ii + 5]), (weight_out[ii + 6]), (weight_out[ii + 7]), tmp_input2, temp_result2);
                    temp_result3 = _vmac5((weight_out[ii + 8]), (weight_out[ii + 9]), (weight_out[ii + 10]), (weight_out[ii + 11]), tmp_input3, temp_result3);
                    temp_result4 = _vmac5((weight_out[ii + 12]), (weight_out[ii + 13]), (weight_out[ii + 14]), (weight_out[ii + 15]), tmp_input4, temp_result4);
                }
                //rt_kprintf("1x1_conv111-%d\n",j);
                temp_result1 = (temp_result1 + bias_vec + temp_result2 + temp_result3 + temp_result4);
                int2xN_t vec_lo = _vunpack_lo(temp_result1);
                int2xN_t vec_hi = _vunpack_hi(temp_result1);
                int4xN_t temp_result5 = _vpack(_vshiftr(vec_lo, shift_vec_lo), _vshiftr(vec_hi, shift_vec_hi));
                char4xN_t temp1 = _vcastc4n(_sat, _vcasts4n(_sat, temp_result5));
                //rt_kprintf("1x1_conv333-%d\n",j);
                int position000 = i * (output->width * o_c) + j * o_c + vec_part * 16;
//              rt_kprintf("%d, %d, %d, %d\n",calcu_oc,position000,o_c,vec_part);
                memcpy(output->data_location + position000, &temp1, calcu_oc);
//              rt_kprintf("1x1_conv222-%d\n",j);
            }
        }
    }
//    uint32_t end_time = TIMER0_END();
//    rt_kprintf("1x1_conv\n");
}


