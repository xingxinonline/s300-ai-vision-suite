__attribute__((section(".text_fd")))
void pooling(struct Uint8Tensor *input, struct Uint8Tensor *output, struct Structure *pooling_params)
{
    int position_h = 0;
    int position_w = 0;
    int pooling_method = pooling_params->pooling_method;
    int o_c = output->channel;
    assert(pooling_method == 0);
    assert(o_c == 16 || o_c == 64);
    int input_step0 = (input->width * input->channel);
    unsigned char E = 0xff;
    if (o_c == 16)
    {
        for (int i = 0; i < output->height; i++)
        {
            for (int j = 0; j < output->width; j++)
            {
                position_h = i * 2;
                position_w = j * 2;
                uchar8xN_t A = *(uchar8xN_t *)(input->data_location + position_h * input_step0 + position_w * o_c);
                uchar8xN_t B = *(uchar8xN_t *)(input->data_location + (position_h + 1) * input_step0 + position_w * o_c);
                uchar8xN_t C = *(uchar8xN_t *)(input->data_location + position_h * input_step0 + (position_w + 1) * o_c);
                uchar8xN_t D = *(uchar8xN_t *)(input->data_location + (position_h + 1) * input_step0 + (position_w + 1) * o_c);
                uchar8xN_t O = _vmax4(A, B, C, D, E);
                memcpy(output->data_location + i * (output->width * o_c) + j * (o_c), &O, o_c);
            }
        }
    }
    else
    {
        for (int i = 0; i < output->height; i++)
        {
            for (int j = 0; j < output->width; j++)
            {
                position_h = i * 2;
                position_w = j * 2;
                uchar8xN_t A = *(uchar8xN_t *)(input->data_location + position_h * input_step0 + position_w * o_c);
                uchar8xN_t B = *(uchar8xN_t *)(input->data_location + (position_h + 1) * input_step0 + position_w * o_c);
                uchar8xN_t C = *(uchar8xN_t *)(input->data_location + position_h * input_step0 + (position_w + 1) * o_c);
                uchar8xN_t D = *(uchar8xN_t *)(input->data_location + (position_h + 1) * input_step0 + (position_w + 1) * o_c);
                uchar8xN_t O = _vmax4(A, B, C, D, E);
                memcpy(output->data_location + i * (output->width * o_c) + j * (o_c), &O, 32);
                A = *(uchar8xN_t *)(input->data_location + position_h * input_step0 + position_w * o_c + 32);
                B = *(uchar8xN_t *)(input->data_location + (position_h + 1) * input_step0 + position_w * o_c + 32);
                C = *(uchar8xN_t *)(input->data_location + position_h * input_step0 + (position_w + 1) * o_c + 32);
                D = *(uchar8xN_t *)(input->data_location + (position_h + 1) * input_step0 + (position_w + 1) * o_c + 32);
                O = _vmax4(A, B, C, D, E);
                memcpy(output->data_location + i * (output->width * o_c) + j * (o_c) + 32, &O, 32);
            }
        }
    }
}

